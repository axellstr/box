---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
---

<Layout title="Checkout Cancelled — sexbox.shop">
  <div class="container-main py-16 sm:py-24 text-center">
    <div class="mx-auto max-w-md">
      <h1 class="font-heading text-3xl sm:text-4xl font-bold text-ink uppercase mb-4">
        Checkout Cancelled
      </h1>

      <p class="text-ink/60 leading-relaxed mb-8">
        No worries — your cart is still saved. Come back whenever you're ready.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/cart"
          class="inline-flex items-center justify-center font-medium rounded-button bg-ink text-surface hover:bg-ink/85 active:scale-[0.98] text-sm px-8 py-3.5 transition-all"
        >
          Back to Cart
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center font-medium rounded-button border border-ink/20 text-ink hover:bg-ink/5 active:scale-[0.98] text-sm px-8 py-3.5 transition-all"
        >
          Continue Shopping
        </a>
      </div>
    </div>
  </div>
</Layout>
