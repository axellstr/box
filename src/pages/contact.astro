---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import Button from "../components/ui/Button.astro";
import { Mail, Phone, MapPin, ChevronDown } from "@lucide/astro";

const faqs = [
  {
    question: "How do I track my order?",
    answer: "Once your order is shipped, you'll receive an email with a tracking number. You can use this number on our tracking page or the carrier's website to monitor your delivery status in real-time.",
  },
  {
    question: "What is your return policy?",
    answer: "We offer a 30-day return policy on all unused items in their original packaging. Simply initiate a return through your account dashboard or contact our support team for assistance.",
  },
  {
    question: "How long does shipping take?",
    answer: "Standard shipping typically takes 5-7 business days. Express shipping is available for 2-3 business day delivery. International orders may take 10-14 business days depending on the destination.",
  },
  {
    question: "Do you offer international shipping?",
    answer: "Yes! We ship to over 50 countries worldwide. Shipping costs and delivery times vary by location. You can see the exact cost at checkout after entering your shipping address.",
  },
  {
    question: "How can I contact customer support?",
    answer: "You can reach us via the contact form on this page, email us at support@sexbox.shop, or call us during business hours at +1 (555) 123-4567. We typically respond within 24 hours.",
  },
  {
    question: "What payment methods do you accept?",
    answer: "We accept Visa, Mastercard, PayPal, Apple Pay, and Google Pay. All transactions are encrypted and secured for your safety.",
  },
];
---

<Layout title="Contact & FAQ — sexbox.shop">
  <div class="container-main py-4 sm:py-6 lg:py-8">
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />

    <h1 class="font-heading text-3xl sm:text-4xl font-bold text-ink uppercase mb-8 sm:mb-12">
      Get in Touch
    </h1>

    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 mb-16">
      <!-- Contact Form -->
      <div class="border border-ink/12 rounded-card p-6 sm:p-8">
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-ink mb-6">Send Us a Message</h2>
        <form class="space-y-5">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-sm font-medium text-ink mb-2">Name</label>
              <input
                type="text"
                id="name"
                placeholder="Your name"
                class="w-full border border-ink/12 rounded-xl px-4 py-3 text-sm placeholder:text-ink/45 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-ink mb-2">Email</label>
              <input
                type="email"
                id="email"
                placeholder="you@example.com"
                class="w-full border border-ink/12 rounded-xl px-4 py-3 text-sm placeholder:text-ink/45 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition"
              />
            </div>
          </div>
          <div>
            <label for="subject" class="block text-sm font-medium text-ink mb-2">Subject</label>
            <input
              type="text"
              id="subject"
              placeholder="How can we help?"
              class="w-full border border-ink/12 rounded-xl px-4 py-3 text-sm placeholder:text-ink/45 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-ink mb-2">Message</label>
            <textarea
              id="message"
              rows="5"
              placeholder="Tell us more about your inquiry..."
              class="w-full border border-ink/12 rounded-xl px-4 py-3 text-sm placeholder:text-ink/45 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition resize-none"
            ></textarea>
          </div>
          <Button variant="primary" size="lg" fullWidth>
            Send Message
          </Button>
        </form>

        <!-- Contact Info -->
        <div class="mt-8 pt-6 border-t border-ink/12 grid sm:grid-cols-3 gap-4">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-muted rounded-full flex items-center justify-center shrink-0">
              <Mail size={16} class="text-ink/60" />
            </div>
            <div>
              <p class="text-xs text-ink/45 mb-0.5">Email</p>
              <p class="text-sm font-medium text-ink">support@sexbox.shop</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-muted rounded-full flex items-center justify-center shrink-0">
              <Phone size={16} class="text-ink/60" />
            </div>
            <div>
              <p class="text-xs text-ink/45 mb-0.5">Phone</p>
              <p class="text-sm font-medium text-ink">+1 (555) 123-4567</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-muted rounded-full flex items-center justify-center shrink-0">
              <MapPin size={16} class="text-ink/60" />
            </div>
            <div>
              <p class="text-xs text-ink/45 mb-0.5">Address</p>
              <p class="text-sm font-medium text-ink">123 Main St, NYC</p>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Accordion -->
      <div>
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-ink mb-6">Frequently Asked Questions</h2>
        <div class="faq-accordion space-y-3">
          {faqs.map((faq, i) => (
            <details
              class="group border border-ink/12 rounded-xl overflow-hidden"
              open={i === 0}
              data-faq-item
            >
              <summary class="flex items-center justify-between cursor-pointer p-5 text-sm sm:text-base font-medium text-ink hover:bg-ink/[0.04] transition-colors duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] list-none [&::-webkit-details-marker]:hidden">
                {faq.question}
                <ChevronDown
                  size={18}
                  class="text-ink/45 transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] group-open:rotate-180 shrink-0 ml-4"
                />
              </summary>
              <div class="faq-answer-wrap">
                <div class="px-5 pb-5 text-sm text-ink/60 leading-relaxed border-t border-ink/8 pt-4 faq-answer-inner">
                  {faq.answer}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .faq-accordion details[data-faq-item] .faq-answer-wrap {
    overflow: hidden;
    transition: height 0.35s var(--ease-smooth, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .faq-accordion details[data-faq-item] .faq-answer-inner {
    transition: opacity 0.3s var(--ease-smooth, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .faq-accordion details[data-faq-item]:not([open]) .faq-answer-inner {
    opacity: 0;
  }

  .faq-accordion details[data-faq-item][open] .faq-answer-inner {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-accordion details[data-faq-item] .faq-answer-wrap,
    .faq-accordion details[data-faq-item] .faq-answer-inner {
      transition: none;
    }
  }
</style>

<script>
  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function getWrap(details: HTMLDetailsElement): HTMLElement | null {
    return details.querySelector(".faq-answer-wrap");
  }

  function closeDetails(details: HTMLDetailsElement, wrap: HTMLElement, instant: boolean): void {
    if (instant) {
      details.open = false;
      wrap.style.height = "";
      return;
    }
    const h = wrap.scrollHeight;
    wrap.style.height = `${h}px`;
    wrap.getBoundingClientRect();
    wrap.style.height = "0px";

    const onEnd = (e: TransitionEvent) => {
      if (e.propertyName !== "height") return;
      wrap.removeEventListener("transitionend", onEnd);
      details.open = false;
      wrap.style.height = "";
    };
    wrap.addEventListener("transitionend", onEnd);
  }

  function openDetails(details: HTMLDetailsElement, wrap: HTMLElement, instant: boolean): void {
    if (instant) {
      details.open = true;
      wrap.style.height = "";
      return;
    }
    details.open = true;
    wrap.style.height = "0px";
    wrap.getBoundingClientRect();
    const target = wrap.scrollHeight;
    wrap.style.height = `${target}px`;

    const onEnd = (e: TransitionEvent) => {
      if (e.propertyName !== "height") return;
      wrap.removeEventListener("transitionend", onEnd);
      wrap.style.height = "auto";
    };
    wrap.addEventListener("transitionend", onEnd);
  }

  function initFaqAccordion() {
    const root = document.querySelector(".faq-accordion");
    if (!root) return;
    const items = [...root.querySelectorAll<HTMLDetailsElement>("details[data-faq-item]")];
    const instant = prefersReducedMotion();

    items.forEach((details) => {
      const wrap = getWrap(details);
      if (!wrap) return;
      if (details.open) {
        wrap.style.height = "auto";
      } else {
        wrap.style.height = "0px";
      }
    });

    items.forEach((details) => {
      const summary = details.querySelector("summary");
      if (!summary) return;

      summary.addEventListener("click", (e) => {
        e.preventDefault();
        const wrap = getWrap(details);
        if (!wrap) return;

        const wasOpen = details.open;

        if (wasOpen) {
          closeDetails(details, wrap, instant);
        } else {
          items.forEach((other) => {
            if (other !== details && other.open) {
              const ow = getWrap(other);
              if (ow) closeDetails(other, ow, instant);
            }
          });
          openDetails(details, wrap, instant);
        }
      });
    });
  }

  initFaqAccordion();
</script>
