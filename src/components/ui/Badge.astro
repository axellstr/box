---
interface Props {
  variant?: "sale" | "new" | "default";
  class?: string;
}

const { variant = "default", class: className = "" } = Astro.props;

const variants: Record<string, string> = {
  sale: "bg-accent/10 text-accent",
  new: "bg-accent-dark/10 text-accent-dark",
  default: "bg-muted text-ink/70",
};
---

<span class:list={["inline-flex items-center text-xs font-medium px-3 py-1 rounded-full", variants[variant], className]}>
  <slot />
</span>
