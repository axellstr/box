---
import { X } from "@lucide/astro";
---

<div
  id="announcement-bar"
  class="bg-ink text-surface text-xs sm:text-sm py-2.5 px-4 flex items-center"
>
  <div class="w-7 shrink-0"></div>
  <p class="flex-1 text-center font-body">
    Sign up and get 20% off to your first order.
    <a href="#" class="underline font-semibold ml-1 hover:text-accent transition-colors">
      Sign Up Now
    </a>
  </p>
  <button
    id="close-announcement"
    class="w-7 shrink-0 flex items-center justify-end text-surface/70 hover:text-surface transition-colors"
    aria-label="Close announcement"
  >
    <X size={18} />
  </button>
</div>

<script>
  const btn = document.getElementById("close-announcement");
  const bar = document.getElementById("announcement-bar");
  btn?.addEventListener("click", () => {
    bar?.classList.add("hidden");
  });
</script>
