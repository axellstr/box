---
import { heroPackages } from "../../data/products";

const loop = [...heroPackages, ...heroPackages, ...heroPackages, ...heroPackages];
---

<section class="shrink-0 bg-ink py-5 overflow-hidden" aria-label="Shop packages">
  <div class="flex animate-ticker whitespace-nowrap">
    {loop.map((pkg, i) => (
      <a
        href={`/product/${pkg.slug}`}
        class="font-heading text-surface text-2xl sm:text-3xl lg:text-4xl font-bold mx-8 sm:mx-12 lg:mx-16 opacity-90 hover:opacity-100 focus-visible:opacity-100 shrink-0 uppercase tracking-wide transition-opacity outline-none focus-visible:ring-2 focus-visible:ring-surface focus-visible:ring-offset-2 focus-visible:ring-offset-ink rounded-sm"
      >
        {pkg.name}
      </a>
    ))}
  </div>
</section>
