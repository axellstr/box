---
import SectionHeading from "../ui/SectionHeading.astro";
import TestimonialCard from "../ui/TestimonialCard.astro";
import { testimonials } from "../../data/products";
import { ArrowLeft, ArrowRight } from "@lucide/astro";
---

<section class="py-12 sm:py-16 lg:py-20">
  <div class="container-main">
    <div class="flex items-end justify-between mb-8 sm:mb-10">
      <SectionHeading class="text-left !text-3xl sm:!text-4xl lg:!text-5xl">
        Our Happy Customers
      </SectionHeading>
      <div class="hidden sm:flex items-center gap-2">
        <button class="w-10 h-10 rounded-full border border-ink/20 flex items-center justify-center hover:bg-ink/5 transition-colors" aria-label="Previous">
          <ArrowLeft size={18} />
        </button>
        <button class="w-10 h-10 rounded-full border border-ink/20 flex items-center justify-center hover:bg-ink/5 transition-colors" aria-label="Next">
          <ArrowRight size={18} />
        </button>
      </div>
    </div>

    <div class="flex gap-4 sm:gap-5 overflow-x-auto scrollbar-hide snap-x snap-mandatory pb-4 -mx-4 px-4">
      {testimonials.map((t) => (
        <TestimonialCard author={t.author} rating={t.rating} text={t.text} verified={t.verified} />
      ))}
    </div>
  </div>
</section>
