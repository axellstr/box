---
import Button from "../ui/Button.astro";
import logoSvg from "../../assets/icons/logo.svg";
---

<section class="flex flex-col min-h-[80svh] lg:min-h-[80svh] bg-surface overflow-hidden">
  <!-- Mobile layout: relative container with logo centered and text overlay at bottom-left -->
  <div class="lg:hidden relative flex-1 flex flex-col min-h-0">
    <!-- Hero Logo - large and centered -->
    <div class="flex-1 flex items-center justify-center px-6 pt-6 pb-24">
      <img
        src={logoSvg.src}
        alt="Sexbox brand mark"
        class="w-full max-w-[280px] sm:max-w-[340px] h-auto object-contain select-none"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <!-- Text overlay - bottom left -->
    <div class="absolute bottom-0 left-0 right-0 p-6">
      <h1 class="font-heading text-3xl sm:text-4xl font-bold text-ink leading-[1.05] mb-3 text-balance">
        Unbox <span class="text-orange-500">pleasure</span>,<br />
        Unbox <span class="text-purple-500">passion</span>
      </h1>
      <Button variant="primary" size="md" href="/shop">
        Shop Now
      </Button>
    </div>
  </div>

  <!-- Desktop layout: side by side -->
  <div class="hidden lg:flex container-main flex-1 flex-row items-center justify-center gap-12 min-h-0 py-14 w-full">
    <!-- Text -->
    <div class="flex-1 shrink-0 pr-12 max-w-xl">
      <h1 class="font-heading text-[64px] font-bold text-ink leading-[1.05] mb-5 text-balance">
        Unbox <span class="text-orange-500">pleasure</span>,<br />
        Unbox <span class="text-purple-500">passion</span>
      </h1>
      <Button variant="primary" size="lg" href="/shop">
        Shop Now
      </Button>
    </div>

    <!-- Hero Logo -->
    <div class="flex flex-1 items-center justify-center">
      <img
        src={logoSvg.src}
        alt="Sexbox brand mark"
        class="w-full max-w-lg h-auto max-h-[min(58svh,36rem)] object-contain select-none"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
