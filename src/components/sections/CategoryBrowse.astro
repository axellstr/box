---
import SectionHeading from "../ui/SectionHeading.astro";
import { categories } from "../../data/products";

const displayCategories = categories.filter(c => c.slug !== "all").slice(0, 4);
---

<section class="py-12 sm:py-16 lg:py-20">
  <div class="container-main">
    <div class="bg-muted rounded-card p-6 sm:p-10 lg:p-16">
      <SectionHeading class="mb-8 sm:mb-10">Browse by Package Type</SectionHeading>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        <!-- First row: 2 items -->
        {displayCategories.slice(0, 2).map((cat, i) => (
          <a
            href={`/shop?category=${cat.slug}`}
            class:list={[
              "relative rounded-card overflow-hidden bg-surface group min-h-[190px] sm:min-h-[220px] lg:min-h-[290px]",
              i === 0 ? "lg:col-span-1" : "lg:col-span-2",
            ]}
          >
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-ink/30" />
            <img
              src={cat.image}
              alt={cat.name}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute bottom-4 left-5 sm:bottom-6 sm:left-7 z-10">
              <span class="font-heading font-bold text-xl sm:text-2xl lg:text-[28px] text-ink block">
                {cat.name}
              </span>
              <span class="text-sm text-ink/70">{cat.count} packages</span>
            </div>
          </a>
        ))}
        <!-- Second row: 2 items -->
        {displayCategories.slice(2, 4).map((cat, i) => (
          <a
            href={`/shop?category=${cat.slug}`}
            class:list={[
              "relative rounded-card overflow-hidden bg-surface group min-h-[190px] sm:min-h-[220px] lg:min-h-[290px]",
              i === 0 ? "lg:col-span-2" : "lg:col-span-1",
            ]}
          >
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-ink/30" />
            <img
              src={cat.image}
              alt={cat.name}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute bottom-4 left-5 sm:bottom-6 sm:left-7 z-10">
              <span class="font-heading font-bold text-xl sm:text-2xl lg:text-[28px] text-ink block">
                {cat.name}
              </span>
              <span class="text-sm text-ink/70">{cat.count} packages</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
