---
const shopLinks = [
  { label: "All Products", href: "/shop" },
  { label: "New Arrivals", href: "/shop?sort=newest" },
  { label: "Best Sellers", href: "/shop?sort=popular" },
  { label: "Gift Boxes", href: "/shop?category=gift-boxes" },
];

const helpLinks = [
  { label: "Customer Support", href: "/contact" },
  { label: "Shipping & Returns", href: "#" },
  { label: "FAQ", href: "#" },
  { label: "Track My Order", href: "#" },
];

const legalLinks = [
  { label: "Terms & Conditions", modal: "terms" },
  { label: "Privacy Policy", modal: "privacy" },
  { label: "Cookie Policy", modal: "cookies" },
  { label: "Refund Policy", modal: "refund" },
];
---

<footer>
  <!-- Newsletter -->
  <div class="w-full px-4 sm:px-6">
    <section class="rounded-card relative z-10 mx-auto w-full max-w-[1240px] px-6 py-9 lg:pl-[92px] lg:pr-16 lg:py-11 -mb-20 overflow-hidden" style="background-color: #141301; background-image: radial-gradient(circle, rgba(255,255,255,0.10) 1.5px, transparent 1.5px); background-size: 22px 22px;">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <h2 class="font-heading text-surface text-2xl sm:text-3xl lg:text-[40px] font-bold leading-tight max-w-md text-balance uppercase">
          Stay Up to Date About Our Latest Offers
        </h2>
        <div class="flex flex-col gap-3 w-full lg:max-w-sm">
          <input
            type="email"
            placeholder="Enter your email address"
            class="w-full bg-surface rounded-full py-3 px-4 text-sm text-ink placeholder:text-ink/45 text-center focus:outline-none focus:ring-2 focus:ring-accent/40"
          />
          <button class="w-full bg-surface text-ink font-medium rounded-full py-3 text-sm hover:bg-accent hover:text-surface transition-colors">
            Subscribe to Newsletter
          </button>
        </div>
      </div>
    </section>
  </div>

  <!-- Links -->
  <div class="bg-gray-200 pt-28 pb-8">
    <div class="container-main">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pb-8 border-b border-ink/20">
        <!-- Brand column -->
        <div class="col-span-2 md:col-span-1">
          <a href="/" class="inline-block mb-4">
            <img src="/sexlogo.png" alt="sexbox.shop" class="h-7 sm:h-8 w-auto" />
          </a>
          <p class="text-sm text-ink/60 leading-relaxed mb-5 max-w-xs">
            Curated adult lifestyle boxes delivered discreetly to your door. Quality products, zero judgement.
          </p>
          <div class="flex items-center gap-3">
            <a href="#" class="w-7 h-7 bg-surface border border-ink/20 rounded-full flex items-center justify-center hover:bg-ink hover:text-surface hover:border-ink transition-colors" aria-label="Twitter">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M22.46 6c-.77.35-1.6.58-2.46.69a4.3 4.3 0 0 0 1.88-2.38 8.59 8.59 0 0 1-2.72 1.04 4.28 4.28 0 0 0-7.32 3.91A12.16 12.16 0 0 1 3 4.79a4.28 4.28 0 0 0 1.32 5.72 4.24 4.24 0 0 1-1.94-.54v.05a4.28 4.28 0 0 0 3.43 4.2 4.27 4.27 0 0 1-1.93.07 4.29 4.29 0 0 0 4 2.97A8.59 8.59 0 0 1 2 19.54a12.13 12.13 0 0 0 6.56 1.92c7.88 0 12.2-6.53 12.2-12.2 0-.19 0-.37-.01-.56A8.72 8.72 0 0 0 23 6.29a8.49 8.49 0 0 1-2.54.7z"/></svg>
            </a>
            <a href="#" class="w-7 h-7 bg-ink text-surface rounded-full flex items-center justify-center hover:bg-accent hover:border-accent transition-colors" aria-label="Facebook">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="#" class="w-7 h-7 bg-surface border border-ink/20 rounded-full flex items-center justify-center hover:bg-ink hover:text-surface hover:border-ink transition-colors" aria-label="Instagram">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="#" class="w-7 h-7 bg-surface border border-ink/20 rounded-full flex items-center justify-center hover:bg-ink hover:text-surface hover:border-ink transition-colors" aria-label="TikTok">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.78a4.85 4.85 0 0 1-1.01-.09z"/></svg>
            </a>
          </div>
        </div>

        <!-- Link columns -->
        <div>
          <h3 class="text-sm font-semibold tracking-widest uppercase mb-5">Shop</h3>
          <ul class="space-y-3">
            {shopLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink/60 hover:text-ink transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-semibold tracking-widest uppercase mb-5">Help</h3>
          <ul class="space-y-3">
            {helpLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink/60 hover:text-ink transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-semibold tracking-widest uppercase mb-5">Legal</h3>
          <ul class="space-y-3">
            {legalLinks.map((link) => (
              <li>
                <button
                  data-legal-modal={link.modal}
                  class="text-sm text-ink/60 hover:text-ink transition-colors text-left cursor-pointer"
                >
                  {link.label}
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Bottom -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6">
        <p class="text-sm text-ink/60">
          sexbox.shop &copy; 2025–2026, All Rights Reserved
        </p>
        <div class="flex items-center gap-2">
          <svg width="44" height="28" viewBox="0 0 44 28" fill="none" class="rounded"><rect width="44" height="28" rx="4" fill="#1A1F71"/><text x="8" y="19" fill="white" font-size="11" font-weight="bold" font-family="sans-serif">VISA</text></svg>
          <svg width="44" height="28" viewBox="0 0 44 28" fill="none" class="rounded"><rect width="44" height="28" rx="4" fill="#252525"/><circle cx="17" cy="14" r="8" fill="#EB001B"/><circle cx="27" cy="14" r="8" fill="#F79E1B"/><path d="M22 7.27a8 8 0 0 1 0 13.46 8 8 0 0 1 0-13.46z" fill="#FF5F00"/></svg>
          <svg width="44" height="28" viewBox="0 0 44 28" fill="none" class="rounded"><rect width="44" height="28" rx="4" fill="#003087"/><text x="5" y="18" fill="white" font-size="9" font-weight="bold" font-family="sans-serif">PayPal</text></svg>
          <svg width="44" height="28" viewBox="0 0 44 28" fill="none" class="rounded"><rect width="44" height="28" rx="4" fill="#000"/><text x="6" y="18" fill="white" font-size="8" font-weight="bold" font-family="sans-serif">Apple</text></svg>
          <svg width="44" height="28" viewBox="0 0 44 28" fill="none" class="rounded"><rect width="44" height="28" rx="4" fill="#fff"/><text x="6" y="18" fill="#5F6368" font-size="9" font-weight="bold" font-family="sans-serif">G Pay</text></svg>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Legal Modals -->
<div id="legal-modal-overlay" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4" aria-hidden="true">
  <!-- Backdrop -->
  <div id="legal-modal-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

  <!-- Panel -->
  <div
    id="legal-modal-panel"
    class="relative w-full sm:max-w-2xl max-h-[90dvh] bg-surface rounded-t-3xl sm:rounded-2xl shadow-2xl flex flex-col opacity-0 translate-y-6 scale-95 transition-all duration-300 overflow-hidden"
  >
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-ink/10 shrink-0">
      <h2 id="legal-modal-title" class="font-heading font-bold text-lg uppercase tracking-wide"></h2>
      <button
        id="legal-modal-close"
        class="w-8 h-8 rounded-full bg-ink/5 hover:bg-ink/10 flex items-center justify-center transition-colors"
        aria-label="Close"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- Content -->
    <div id="legal-modal-body" class="overflow-y-auto px-6 py-6 text-sm text-ink/70 leading-relaxed space-y-4 scrollbar-hide"></div>

    <!-- Footer -->
    <div class="px-6 py-4 border-t border-ink/10 shrink-0 flex items-center justify-between bg-gray-50">
      <p class="text-xs text-ink/40">Last updated: January 2026</p>
      <button
        id="legal-modal-accept"
        class="px-5 py-2 bg-ink text-surface text-xs font-semibold rounded-full hover:bg-accent transition-colors"
      >
        Got it
      </button>
    </div>
  </div>
</div>

<script>
  const modals: Record<string, { title: string; content: string }> = {
    terms: {
      title: "Terms & Conditions",
      content: `
        <h3 class="font-semibold text-ink text-base">1. Acceptance of Terms</h3>
        <p>By accessing or purchasing from sexbox.shop, you confirm that you are at least 18 years of age and legally permitted to purchase adult products in your jurisdiction. Use of this site constitutes your agreement to these terms.</p>

        <h3 class="font-semibold text-ink text-base">2. Products & Descriptions</h3>
        <p>We make every effort to display our products accurately. Colours, sizes, and packaging may vary slightly from images shown. All products are intended for adult personal use only and must be used responsibly in accordance with included instructions.</p>

        <h3 class="font-semibold text-ink text-base">3. Age Verification</h3>
        <p>We reserve the right to request proof of age at any time. Orders placed by individuals under 18 will be cancelled and refunded. By completing a purchase you confirm your age and accept sole responsibility for this declaration.</p>

        <h3 class="font-semibold text-ink text-base">4. Pricing & Payment</h3>
        <p>All prices are listed in EUR and include applicable VAT. We accept Visa, Mastercard, PayPal, Apple Pay, and Google Pay. Payments are processed securely via Stripe. We reserve the right to update pricing at any time without prior notice.</p>

        <h3 class="font-semibold text-ink text-base">5. Intellectual Property</h3>
        <p>All content on this site — including logos, copy, imagery, and design — is the property of sexbox.shop and may not be reproduced without written permission.</p>

        <h3 class="font-semibold text-ink text-base">6. Limitation of Liability</h3>
        <p>sexbox.shop is not liable for any indirect, incidental, or consequential damages arising from the use of our products or services. Our liability is limited to the value of the order placed.</p>

        <h3 class="font-semibold text-ink text-base">7. Governing Law</h3>
        <p>These terms are governed by the laws of Greece. Any disputes shall be subject to the exclusive jurisdiction of the courts of Athens.</p>
      `,
    },
    privacy: {
      title: "Privacy Policy",
      content: `
        <h3 class="font-semibold text-ink text-base">1. Data We Collect</h3>
        <p>We collect information you provide when placing an order: name, email, shipping address, and payment details. We also collect anonymised browsing data (pages visited, device type) to improve your experience.</p>

        <h3 class="font-semibold text-ink text-base">2. How We Use Your Data</h3>
        <p>Your data is used exclusively to fulfil orders, communicate about your purchases, and (if opted-in) send you offers and updates. We never sell or share your personal information with third parties for marketing purposes.</p>

        <h3 class="font-semibold text-ink text-base">3. Discretion Guarantee</h3>
        <p>We take your privacy seriously. All packages are shipped in plain, unmarked boxes. Your bank statement will show a neutral descriptor — never the name of our shop. Your purchase history is stored securely and never visible to third parties.</p>

        <h3 class="font-semibold text-ink text-base">4. Data Storage & Security</h3>
        <p>Your data is stored on encrypted servers within the EU. Payment information is handled entirely by Stripe and never stored on our servers. We comply fully with GDPR regulations.</p>

        <h3 class="font-semibold text-ink text-base">5. Your Rights</h3>
        <p>You have the right to access, correct, or delete your personal data at any time. To exercise these rights, contact us at privacy@sexbox.shop. We will respond within 30 days.</p>

        <h3 class="font-semibold text-ink text-base">6. Third-Party Services</h3>
        <p>We use Stripe for payments and Vercel for hosting. These services have their own privacy policies. We use anonymised analytics (no personal data) to understand site traffic.</p>
      `,
    },
    cookies: {
      title: "Cookie Policy",
      content: `
        <h3 class="font-semibold text-ink text-base">What Are Cookies?</h3>
        <p>Cookies are small text files stored on your device when you visit a website. They help us remember your preferences and understand how our site is used.</p>

        <h3 class="font-semibold text-ink text-base">Cookies We Use</h3>
        <p><strong class="text-ink">Essential cookies</strong> — required for the site to function. These include your cart contents and session state. You cannot opt out of these without breaking core functionality.</p>
        <p><strong class="text-ink">Analytics cookies</strong> — anonymised data about which pages are visited and how long users stay. This helps us improve the shopping experience. No personal data is collected.</p>
        <p><strong class="text-ink">Preference cookies</strong> — remember choices you make (such as currency or notification dismissals) so you don't have to repeat them on future visits.</p>

        <h3 class="font-semibold text-ink text-base">What We Don't Do</h3>
        <p>We do not use advertising or tracking cookies. We do not share cookie data with advertisers or social platforms. Your browsing history on our site stays on our site.</p>

        <h3 class="font-semibold text-ink text-base">Managing Cookies</h3>
        <p>You can control or delete cookies through your browser settings at any time. Note that disabling essential cookies will prevent the cart and checkout from working correctly.</p>
      `,
    },
    refund: {
      title: "Refund Policy",
      content: `
        <h3 class="font-semibold text-ink text-base">Our Commitment</h3>
        <p>Your satisfaction is important to us. If something isn't right with your order, we want to make it right — quickly and without fuss.</p>

        <h3 class="font-semibold text-ink text-base">Returns Window</h3>
        <p>You have <strong class="text-ink">14 days</strong> from the date of delivery to request a return or exchange. Items must be unused, in their original sealed packaging, and accompanied by proof of purchase.</p>

        <h3 class="font-semibold text-ink text-base">Non-Returnable Items</h3>
        <p>For hygiene reasons, we cannot accept returns on opened or used intimate products. If your item arrived damaged or defective, this exception does not apply — please contact us immediately with photos and we will resolve it.</p>

        <h3 class="font-semibold text-ink text-base">How to Request a Refund</h3>
        <p>Email us at returns@sexbox.shop with your order number and reason for return. We'll reply within 2 business days with return instructions. Return shipping costs are the customer's responsibility unless the item was faulty.</p>

        <h3 class="font-semibold text-ink text-base">Refund Timeline</h3>
        <p>Once we receive and inspect the returned item, refunds are processed within <strong class="text-ink">5–7 business days</strong> to your original payment method. You will receive an email confirmation when the refund is issued.</p>

        <h3 class="font-semibold text-ink text-base">Damaged or Wrong Items</h3>
        <p>If you received a damaged, defective, or incorrect item, contact us within 48 hours of delivery. We will send a replacement or issue a full refund at no cost to you.</p>
      `,
    },
  };

  const overlay = document.getElementById("legal-modal-overlay")!;
  const panel = document.getElementById("legal-modal-panel")!;
  const title = document.getElementById("legal-modal-title")!;
  const body = document.getElementById("legal-modal-body")!;
  const closeBtn = document.getElementById("legal-modal-close")!;
  const acceptBtn = document.getElementById("legal-modal-accept")!;
  const backdrop = document.getElementById("legal-modal-backdrop")!;

  function openModal(key: string) {
    const data = modals[key];
    if (!data) return;
    title.textContent = data.title;
    body.innerHTML = data.content;
    body.scrollTop = 0;
    // show the overlay (removes display:none) then wait two frames
    // so the browser paints the opacity-0 / translate / scale state first
    overlay.classList.remove("hidden");
    overlay.setAttribute("aria-hidden", "false");
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        backdrop.classList.remove("opacity-0");
        backdrop.classList.add("opacity-100");
        panel.classList.remove("opacity-0", "translate-y-6", "scale-95");
        panel.classList.add("opacity-100", "translate-y-0", "scale-100");
      });
    });
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    backdrop.classList.remove("opacity-100");
    backdrop.classList.add("opacity-0");
    panel.classList.remove("opacity-100", "translate-y-0", "scale-100");
    panel.classList.add("opacity-0", "translate-y-6", "scale-95");
    setTimeout(() => {
      overlay.classList.add("hidden");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }, 300);
  }

  document.querySelectorAll("[data-legal-modal]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = (btn as HTMLElement).dataset.legalModal!;
      openModal(key);
    });
  });

  closeBtn.addEventListener("click", closeModal);
  acceptBtn.addEventListener("click", closeModal);
  backdrop.addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>
