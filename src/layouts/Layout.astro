---
import "../styles/global.css";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import AnnouncementBar from "../components/sections/AnnouncementBar.astro";
import AgeGate from "../components/ui/AgeGate.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "sexbox.shop — Find Your Intimate Discoveries",
  description = "Premium intimate products curated for your pleasure. Explore our collection of vibrators, accessories, lubricants, and more.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@200,300,400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <AnnouncementBar />
    <Header />
    <main class="flex min-h-0 flex-1 flex-col">
      <slot />
    </main>
    <Footer />
    <AgeGate />
  </body>
</html>
